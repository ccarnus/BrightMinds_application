{
  "expo": {
    "name": "BrightMinds",
    "slug": "BrightMindsBeta",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/BrightMinds/android_icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/BrightMinds/splash.png",
      "backgroundColor": "#f1f1f1"
    },
    "statusBar": {
      "backgroundColor": "#ffffff",
      "style": "light"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/BrightMinds/ios_icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/BrightMinds/android_icon.png",
        "backgroundColor": "#f1f1f1"
      },
      "package": "com.ccarnus3.brightminds",
      "newArchEnabled": true
    },
    "web": {
      "favicon": "./assets/BrightMinds/ios_icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9c6866c1-2446-45c8-a5b0-82bc6aa94aac"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}
