{
  "expo": {
    "name": "BrightMinds",
    "slug": "BrightMindsBeta",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/BrightMinds/android_icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/BrightMinds/ios_icon.png",
      "bundleIdentifier": "com.brightmindsresearch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/BrightMinds/android_icon.png",
        "backgroundColor": "#f1f1f1"
      },
      "package": "com.ccarnus3.brightminds"
    },
    "extra": {
      "eas": {
        "projectId": "9c6866c1-2446-45c8-a5b0-82bc6aa94aac"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "BrightMinds needs access to your photo library so you can choose a profile picture, a cover image for your article or a video for your research cast.",
          "cameraPermission": "BrightMinds needs access to your camera so you can record a research cast or take a cover photo for your article.",
          "microphonePermission": "BrightMinds needs access to your microphone to record audio for your research cast."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/BrightMinds/splash.png",
          "backgroundColor": "#f1f1f1",
          "resizeMode": "contain",
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/BrightMinds/android_icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-video"
    ]
  }
}
